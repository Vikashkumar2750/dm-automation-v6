# ---------------------------------------------------------------------------
# Copy to .env locally, or paste these as Railway service variables.
# Never commit real values.
# ---------------------------------------------------------------------------

# --- Public (inlined into the browser bundle at build time) ----------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=your-project-ref

# --- Server only -----------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1

# Postgres connection used by the migration runner on boot
DATABASE_URL=postgresql://user:password@host:5432/postgres

# --- Meta (Instagram + Facebook) -------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# --- Google / YouTube (optional, Phase 12) ---------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- AI (Lovable AI Gateway) ------------------------------------------------
LOVABLE_API_KEY=

# --- Scheduled publishing ---------------------------------------------------
# POST https://<your-domain>/api/public/cron/publish-due with header x-cron-secret
CRON_SECRET=

# --- Runtime ----------------------------------------------------------------
PORT=3000
NODE_ENV=production
NITRO_PRESET=node-server
