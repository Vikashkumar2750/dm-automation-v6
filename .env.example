# ---------------------------------------------------------------------------
# For an independently managed backend on Railway; not Lovable Cloud credentials.
# Lovable Cloud does not expose a service-role key or database password.
# Copy to .env locally, or paste these as Railway service variables.
# Never commit real values.
# ---------------------------------------------------------------------------

# --- Public (inlined into the browser bundle at build time) ----------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=your-project-ref

# --- Server only -----------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # required: used to verify user tokens
SUPABASE_SERVICE_ROLE_KEY=                    # required: admin/server writes
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1

# Postgres connection used by the migration runner on boot
DATABASE_URL=postgresql://user:password@host:5432/postgres

# --- Meta (Instagram + Facebook) -------------------------------------------
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# --- Google / YouTube -------------------------------------------------------
# YOUTUBE_* are accepted as aliases of the GOOGLE_OAUTH_* names.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Payments (Razorpay) ----------------------------------------------------
# Test keys keep the app in demo mode (no money is charged).
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=

# --- AI (Lovable AI Gateway) ------------------------------------------------
LOVABLE_API_KEY=

# --- Emails (direct Resend on Railway) --------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Token encryption ------------------------------------------------------
# Base64 encoding of exactly 32 random bytes. Store securely; preserve on redeploy.
# Do not replace a configured key without a planned decrypt/re-encrypt migration.
TOKEN_ENCRYPTION_KEY=

# Canonical public HTTPS origin, without a trailing slash
PUBLIC_APP_URL=

# --- Scheduled publishing ---------------------------------------------------
# POST https://<your-domain>/api/public/cron/publish-due with header x-cron-secret
CRON_SECRET=

# --- Runtime ----------------------------------------------------------------
PORT=3000
NODE_ENV=production
NITRO_PRESET=node-server
